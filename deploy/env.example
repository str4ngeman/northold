# ghcr.io/<github-user-or-org>/<repo>
GHCR_IMAGE=ghcr.io/OWNER/REPO

# Public hostname. Point DNS A/AAAA records here before the first start.
DOMAIN=northold.app
ACME_EMAIL=you@example.com

# Session signing key. Generate with: openssl rand -base64 48
AUTH_SECRET=

# First admin account, created on empty database only.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional. Server-side RPCs (keep private keys off this host).
# MAINNET_RPC_URL=
# SEPOLIA_RPC_URL=
