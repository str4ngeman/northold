# Required for local `next dev` / `next start`
MONGODB_URI=mongodb://127.0.0.1:27017/northold
AUTH_SECRET=change-me

# Seeded on first empty database only
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-me

# Optional. NEXT_PUBLIC_* is inlined at `next build`.
# NEXT_PUBLIC_APP_NAME=Northold
# NEXT_PUBLIC_MAINNET_RPC_URL=
# NEXT_PUBLIC_SEPOLIA_RPC_URL=
# NEXT_PUBLIC_MAINNET_WS_URL=
# NEXT_PUBLIC_SEPOLIA_WS_URL=
# MAINNET_RPC_URL=
# SEPOLIA_RPC_URL=
